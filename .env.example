# --- Echtzeitpreise (Google Flights via SerpApi) ---
# Diesen Token bei https://serpapi.com unter "Your Account" -> API Key kopieren.
SERPAPI_TOKEN=dein_serpapi_key
# Quelle für /api/cheap: "serpapi" (Live) oder "travelpayouts" (Cache-Fallback).
# Wird automatisch auf serpapi gesetzt, sobald ein SERPAPI_TOKEN da ist.
PRICE_SOURCE=serpapi
# Cache-Lebensdauer in Sekunden: identische Suchen werden so lange nicht erneut abgerechnet.
SERPAPI_TTL=600
# Max. Origin/Dest-Paare pro Klick = Anzahl bezahlter Google-Flights-Suchen. Free-Plan = 100/Monat!
SERPAPI_MAX_PAIRS=2
# Exakt wie im Browser, aber langsamer (1 = an).
SERPAPI_DEEP=0

# --- seats.aero process-local soft guard (one Railway replica only) ---
SEATSAERO_SAFETY_FLOOR=200
SEATSAERO_HARD_DISABLED=0

# --- Travelpayouts (Autocomplete + optionaler Cache-Fallback) ---
TRAVELPAYOUTS_TOKEN=dein_travelpayouts_token

# --- Optional: schuetzt nur API-Endpunkte. App einmal mit ?key=... oeffnen. ---
APP_TOKEN=ein_geheimes_passwort

# --- Round-trip continuation (Railway Beta: eine Replica, ein Worker) ---
WEB_CONCURRENCY=1
CONTINUATION_INLINE=0
MAX_CONTINUATIONS_PER_SEARCH=1
CONTINUATION_TIMEOUT_MS=12000

# --- Optional bei Railway/Render ---
SKIPLAG_MAX_WORKERS=8
SKIPLAG_MAX_CANDIDATES=16
